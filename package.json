{
    "name": "oicpp-ide",
    "version": "1.0.0",
    "description": "OICPP IDE for competitive programming",
    "author": {
        "name": "Fantasy_XY808",
        "email": "mywwzh@163.com"
    },
    "homepage": "https://oicpp.mywwzh.top/",
    "license": "AGPL-3.0-only",
    "main": "src/main.js",
    "scripts": {
        "prestart": "npm run prebuild:clangd && npm run prebuild:onboarding",
        "start": "chcp 65001 >nul 2>&1 & electron .",
        "predev": "npm run prebuild:clangd && npm run prebuild:onboarding",
        "dev": "electron . --dev",
        "test": "node --test test/*.test.js",
        "lint": "eslint .",
        "format:check": "prettier --check \"src/**/*.{js,mjs,css,html,json}\" \"scripts/**/*.{js,mjs}\" \"test/**/*.js\" \"*.md\" \".github/**/*.{yml,yaml,md}\" eslint.config.cjs .prettierrc.json package.json",
        "format": "prettier --write \"src/**/*.{js,mjs,css,html,json}\" \"scripts/**/*.{js,mjs}\" \"test/**/*.js\" \"*.md\" \".github/**/*.{yml,yaml,md}\" eslint.config.cjs .prettierrc.json package.json",
        "prebuild:icons": "node scripts/generate-icons.js",
        "prebuild:buildinfo": "node scripts/generate-build-info.js",
        "prebuild:clangd": "node scripts/download-clangd.js",
        "prebuild:compiler": "node scripts/prepare-compiler.js",
        "prebuild:onboarding": "webpack --mode production --target web --entry ./src/renderer/js/onboarding.js --output-path ./src/renderer/js --output-filename onboarding.bundle.js",
        "build": "npm run prebuild:buildinfo && npm run prebuild:icons && npm run prebuild:clangd && npm run prebuild:onboarding && npm run prebuild:compiler && electron-builder"
    },
    "devDependencies": {
        "@applemusic-like-lyrics/core": "0.5.1",
        "@eslint/js": "^9.39.2",
        "@pixi/app": "7.4.3",
        "@pixi/core": "7.4.3",
        "@pixi/display": "7.4.3",
        "@pixi/filter-blur": "7.4.3",
        "@pixi/filter-bulge-pinch": "5.1.1",
        "@pixi/filter-color-matrix": "7.4.3",
        "@pixi/sprite": "7.4.3",
        "electron": "^37.2.0",
        "electron-builder": "^26.0.0",
        "eslint": "^9.39.2",
        "globals": "^16.4.0",
        "html-webpack-plugin": "^5.6.3",
        "icojs": "^0.16.1",
        "monaco-editor-webpack-plugin": "^7.1.0",
        "prettier": "^3.6.2",
        "sharp": "^0.33.5",
        "webpack": "^5.101.0",
        "webpack-cli": "^6.0.1",
        "ws": "^8.18.3"
    },
    "dependencies": {
        "@iktakahiro/markdown-it-katex": "^4.0.1",
        "@xterm/addon-unicode11": "^0.9.0",
        "7zip-bin": "^5.2.0",
        "axios": "latest",
        "extract-zip": "latest",
        "highlight.js": "^11.11.1",
        "iconv-lite": "^0.6.3",
        "katex": "^0.16.25",
        "markdown-it": "^14.1.0",
        "markdown-it-image-figures": "^2.1.1",
        "markdown-it-katex": "^2.0.3",
        "markdown-it-task-lists": "^2.1.1",
        "monaco-editor": "^0.52.2",
        "node-pty": "^1.0.0",
        "node-stream-zip": "^1.15.0",
        "pdfjs-dist": "5.0.375",
        "sharp": "^0.33.5",
        "turndown": "^7.2.2",
        "winreg": "latest",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0"
    },
    "build": {
        "appId": "com.oicpp.ide",
        "productName": "OICPP IDE",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "src/lang/**/*",
            "node_modules/**/*",
            "oicpp.ico"
        ],
        "asarUnpack": [
            "node_modules/node-pty/**/*"
        ],
        "artifactName": "${productName}-${version}-Setup.${ext}",
        "win": {
            "target": "nsis",
            "icon": "oicpp.ico",
            "forceCodeSigning": false,
            "signExts": [
                ".exe",
                ".dll"
            ],
            "extraResources": [
                {
                    "from": "build/clangd/win32",
                    "to": "clangd"
                },
                {
                    "from": "build/compiler/win32",
                    "to": "compiler"
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "selectPerMachineByDefault": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true
        },
        "mac": {
            "icon": "build/icons/png",
            "extraResources": [
                {
                    "from": "build/clangd/darwin",
                    "to": "clangd"
                }
            ]
        },
        "linux": {
            "target": [
                "deb",
                "rpm",
                "AppImage"
            ],
            "category": "Development",
            "icon": "build/icons/png",
            "extraResources": [
                {
                    "from": "build/clangd/linux",
                    "to": "clangd"
                }
            ]
        },
        "deb": {
            "depends": [
                "libgtk-3-0",
                "libnss3",
                "libxss1",
                "libasound2",
                "libxtst6",
                "libc6"
            ]
        },
        "rpm": {
            "depends": [
                "gtk3",
                "nss",
                "libXScrnSaver",
                "alsa-lib",
                "libXtst",
                "glibc"
            ]
        }
    }
}
